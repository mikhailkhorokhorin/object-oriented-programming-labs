{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "lab",
      "type": "pickString",
      "description": "Lab",
      "options": [
        "lab1",
        "lab2",
        "lab3",
        "lab4",
        "lab5",
        "lab6",
        "lab7"
      ]
    },
    {
      "id": "app",
      "type": "pickString",
      "description": "Executable",
      "options": [
        "main"
      ],
      "default": "main"
    }
  ],
  "configurations": [
    {
      "name": "Debug lab executable",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/${input:lab}/${input:lab}_${input:app}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
